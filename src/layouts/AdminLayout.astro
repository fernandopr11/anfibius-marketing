---
import '../styles/global.css';
import AdminLayoutWrapper from '@/components/admin/AdminLayoutWrapper';
interface Props {
    title: string;
}
const {title} = Astro.props;
---

<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>{title} - Anfibius</title>
</head>
<body>
<AdminLayoutWrapper title={title} client:only="react">
    <slot/>
</AdminLayoutWrapper>
</body>
</html>