---
import '../styles/global.css';
import {Image} from 'astro:assets';
import logoAnfivius from '@/images/hero/LogoHorizontal.svg';
import Footer from "@/components/layout/Footer.astro";
import {Calculator, HandCoins, TrendingUp, Users} from "lucide-react";
import {DownloadButton} from "@/components/common/DownloadButton";

// En modo SSR, no necesitamos getStaticPaths
const {slug: slugParam} = Astro.params;

// [...slug] captura como string "path/to/page", lo convertimos
const slug = slugParam || '';


async function getPublicacionByUrl(urlSlug: string) {
    try {
        const API_URL = import.meta.env.PUBLIC_API_URL;
        const url = `${API_URL}/publicaciones/by-url/${urlSlug}`;

        const response = await fetch(url);
        const responseText = await response.text();
        if (!response.ok) {

            return null;
        }

        const data = JSON.parse(responseText);
        return data;
    } catch (error) {
        return null;
    }
}

async function getRecursoByPublicacionId(idPublicacion: number) {
    try {
        const API_URL = import.meta.env.PUBLIC_API_URL;
        const url = `${API_URL}/recursos?publicacion=${idPublicacion}`;

        const response = await fetch(url);

        if (!response.ok) {
            return null;
        }

        const data = await response.json();
        return data;
    } catch (error) {
        return null;
    }
}


// SIEMPRE renderizar la página, incluso si no hay datos
console.log('[SLUG] Llamando a getPublicacionByUrl con:', slug);
let publicacion = null;
let recurso = null;

try {
    publicacion = await getPublicacionByUrl(slug);

    // Si hay publicación, obtener el recurso asociado
    if (publicacion && publicacion.id) {
        recurso = await getRecursoByPublicacionId(publicacion.id);
    }

} catch (error) {

}
---

<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Anfibius</title>
</head>
<body>
<header class="w-full py-4 sm:py-6">
    <div class="container mx-auto px-4 flex justify-center">
        <a href="/">
            <Image
                    src={logoAnfivius}
                    alt="Logo Anfibius"
                    width={300}
                    height={600}
                    class="h-auto w-48 sm:w-56 md:w-64 lg:w-72 p-3 sm:p-5"
            />
        </a>
    </div>
</header>

<main class="bg-background">
    {!publicacion ? (
        <!-- Página cuando no hay datos -->
            <section class="min-h-[60vh] flex items-center justify-center px-4">
                <div class="container mx-auto text-center max-w-md">
                    <h1 class="text-3xl sm:text-4xl font-bold mb-4">404 - Página no encontrada</h1>
                    <p class="text-base sm:text-lg text-gray-600 mb-8">La publicación "{slug}" no existe o no se pudo
                        cargar.</p>
                    <a href="/"
                       class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
                        Volver al inicio
                    </a>
                </div>
            </section>
    ) : (
            <>
                <!-- Página con datos -->
                <!-- Sección Hero con Título 1 y Texto 1 -->
                <section class="container mx-auto px-4 py-8 sm:py-12 md:py-16">
                    <div class="grid gap-8 sm:gap-12 md:grid-cols-2 items-start max-w-6xl mx-auto">
                        <!-- Columna Izquierda: Título 1 y Texto 1 -->
                        <div class="space-y-4 sm:space-y-6 text-center md:text-left order-2 md:order-1">
                            <div class="space-y-3 sm:space-y-4">
                                <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold tracking-tight leading-tight">
                                    {publicacion.titulo1}
                                </h1>
                                <div class="text-sm sm:text-base md:text-lg text-gray-600 leading-relaxed prose prose-sm sm:prose md:prose-lg max-w-none"
                                     set:html={publicacion.texto1}
                                />
                            </div>

                            {
                                <div class="flex justify-center md:justify-start pt-2">
                                    <DownloadButton
                                            idPublicacion={publicacion.id}
                                            nombrePublicacion={publicacion.nombre}
                                            recurso={recurso}
                                            client:load
                                    />
                                </div>
                            }
                        </div>

                        <!-- Columna Derecha: Imagen 1 con iconos decorativos -->
                        {publicacion.imagen1 && (
                                <div class="relative min-h-[320px] sm:min-h-[400px] md:min-h-[500px] flex items-start justify-center order-1 md:order-2">
                                    <div class="relative w-[280px] h-[280px] sm:w-[320px] sm:h-[320px] md:w-[350px] md:h-[350px]">
                                        <div class="absolute inset-0 rounded-[50%] bg-gradient-to-br from-blue-100 to-blue-200 overflow-hidden shadow-xl">
                                            <img
                                                    src={publicacion.imagen1}
                                                    alt={publicacion.titulo1}
                                                    class="h-full w-full object-cover object-center"
                                            />
                                        </div>
                                    </div>
                                </div>
                        )}
                    </div>
                </section>

                <!-- Segunda Sección con Título 2, Texto 2 e Imagen 2 (si existe) -->
                <section>
                    <div class="bg-gray-100 p-6 sm:p-8 md:p-12">
                        <div class="container mx-auto px-4">
                            {/* Si existe imagen2, usar layout de dos columnas */}
                            {publicacion.imagen2 && publicacion.imagen2.trim() !== '' ? (
                                    <div class="grid gap-8 sm:gap-12 md:grid-cols-2 items-start max-w-6xl mx-auto">
                                        {/* Columna Izquierda: Título 2 y Texto 2 */}
                                        <div class="space-y-4 order-2 md:order-1">
                                            <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-800">
                                                {publicacion.titulo2}
                                            </h2>
                                            <div class="text-sm sm:text-base text-gray-700 prose prose-sm sm:prose md:prose-lg max-w-none"
                                                 set:html={publicacion.texto2}
                                            />
                                        </div>

                                        {/* Columna Derecha: Imagen 2 */}
                                        <div class="relative min-h-[280px] sm:min-h-[320px] flex items-start justify-center order-1 md:order-2">
                                            <div class="relative w-full max-w-[400px]">
                                                <div class="rounded-lg overflow-hidden shadow-lg">
                                                    <img
                                                            src={publicacion.imagen2}
                                                            alt={publicacion.titulo2}
                                                            class="w-full h-auto object-cover"
                                                    />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                            ) : (
                                /* Si NO existe imagen2, mantener alineado a la izquierda SIN centrar */
                                    <div class="max-w-6xl mx-auto">
                                        <h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-4 sm:mb-6 text-gray-800">
                                            {publicacion.titulo2}
                                        </h2>
                                        <div class="text-sm sm:text-base text-gray-700 prose prose-sm sm:prose md:prose-lg max-w-none"
                                             set:html={publicacion.texto2}
                                        />
                                    </div>
                            )}
                        </div>
                    </div>
                </section>

                {publicacion && (
                        <Footer
                                showDownloadButton={!!recurso}
                                idPublicacion={publicacion.id}
                                nombrePublicacion={publicacion.nombre}
                                recurso={recurso}
                        />
                )}
            </>
    )}
</main>
</body>
</html>