---
import '../styles/global.css';
import {Image} from 'astro:assets';
import logoAnfivius from '@/images/hero/LogoHorizontal.svg';
import Footer from "@/components/layout/Footer.astro";
import {Calculator, HandCoins, TrendingUp, Users} from "lucide-react";
import {DownloadButton} from "@/components/common/DownloadButton";

// En modo SSR, no necesitamos getStaticPaths
const { slug: slugParam } = Astro.params;

// [...slug] captura como string "path/to/page", lo convertimos
const slug = slugParam || '';

console.log('[SLUG] ============================================');
console.log('[SLUG] Astro.params completo:', JSON.stringify(Astro.params));
console.log('[SLUG] Astro.url.pathname:', Astro.url.pathname);
console.log('[SLUG] slugParam recibido:', slugParam);
console.log('[SLUG] slug procesado:', `"${slug}"`);
console.log('[SLUG] tipo de slug:', typeof slug);
console.log('[SLUG] ============================================');

async function getPublicacionByUrl(urlSlug: string) {
    try {
        const API_URL = import.meta.env.PUBLIC_API_URL;
        const url = `${API_URL}/publicaciones/by-url/${urlSlug}`;
        console.log('[SLUG] ============================================');
        console.log('[SLUG] API_URL:', API_URL);
        console.log('[SLUG] URL completa:', url);
        console.log('[SLUG] Slug buscado:', `"${urlSlug}"`);
        console.log('[SLUG] Longitud del slug:', urlSlug.length);
        
        const response = await fetch(url);
        
        console.log('[SLUG] Response status:', response.status);
        console.log('[SLUG] Response statusText:', response.statusText);
        
        // Intentar leer el body incluso si hay error
        const responseText = await response.text();
        console.log('[SLUG] Response body:', responseText);
        
        if (!response.ok) {
            console.error('[SLUG] ❌ Error en API:', response.status);
            return null;
        }

        const data = JSON.parse(responseText);
        console.log('[SLUG] ✅ Publicación encontrada:', data?.nombre || 'SIN NOMBRE');
        console.log('[SLUG] Datos completos:', JSON.stringify(data, null, 2));
        console.log('[SLUG] ============================================');
        return data;
    } catch (error) {
        console.error('[SLUG] ❌ Excepción al obtener publicación:', error);
        console.error('[SLUG] Error message:', error instanceof Error ? error.message : String(error));
        return null;
    }
}

async function getRecursoByPublicacion(idPublicacion: number) {
    try {
        const API_URL = import.meta.env.PUBLIC_API_URL;
        const response = await fetch(`${API_URL}/recursos?publicacion=${idPublicacion}`);

        if (!response.ok) {
            return null;
        }

        const recursos = await response.json();
        return recursos.length > 0 ? recursos[0] : null;
    } catch (error) {
        console.error('Error al obtener recurso:', error);
        return null;
    }
}

// SIEMPRE renderizar la página, incluso si no hay datos
console.log('[SLUG] Llamando a getPublicacionByUrl con:', slug);
let publicacion = null;
let recurso = null;

try {
    publicacion = await getPublicacionByUrl(slug);
    console.log('[SLUG] Resultado de getPublicacionByUrl:', publicacion ? 'ENCONTRADA' : 'NO ENCONTRADA');
    
    if (publicacion?.id) {
        console.log('[SLUG] ✅ Publicación encontrada, cargando recurso...');
        recurso = await getRecursoByPublicacion(publicacion.id);
    } else {
        console.error('[SLUG] ❌ Publicación no encontrada para:', slug);
        console.error('[SLUG] Renderizando página vacía con mensaje 404');
    }
} catch (error) {
    console.error('[SLUG] ❌ Error general:', error);
}
---

<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Anfibius</title>
</head>
<body>
<header class="w-full py-4 sm:py-6">
    <div class="container mx-auto px-4 flex justify-center">
        <a href="/">
            <Image
                    src={logoAnfivius}
                    alt="Logo Anfibius"
                    width={300}
                    height={600}
                    class="h-auto w-48 sm:w-56 md:w-64 lg:w-72 p-3 sm:p-5"
            />
        </a>
    </div>
</header>

<main class="bg-background">
    {!publicacion ? (
        <!-- Página cuando no hay datos -->
        <section class="min-h-[60vh] flex items-center justify-center px-4">
            <div class="container mx-auto text-center max-w-md">
                <h1 class="text-3xl sm:text-4xl font-bold mb-4">404 - Página no encontrada</h1>
                <p class="text-base sm:text-lg text-gray-600 mb-8">La publicación "{slug}" no existe o no se pudo cargar.</p>
                <a href="/" class="inline-block bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-700 transition">
                    Volver al inicio
                </a>
            </div>
        </section>
    ) : (
        <>
    <!-- Página con datos -->
    <!-- Sección Hero con Título 1 y Texto 1 -->
    <section class="container mx-auto px-4 py-8 sm:py-12 md:py-16">
        <div class="grid gap-8 sm:gap-12 md:grid-cols-2 items-start max-w-6xl mx-auto">
            <!-- Columna Izquierda: Título 1 y Texto 1 -->
            <div class="space-y-4 sm:space-y-6 text-center md:text-left order-2 md:order-1">
                <div class="space-y-3 sm:space-y-4">
                    <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-bold tracking-tight leading-tight">
                        {publicacion.titulo1}
                    </h1>
                    <div class="text-sm sm:text-base md:text-lg text-gray-600 leading-relaxed prose prose-sm sm:prose md:prose-lg max-w-none" set:html={publicacion.texto1}
                    />
                </div>

                {recurso && (
                        <div class="flex justify-center md:justify-start pt-2">
                            <DownloadButton
                                    idPublicacion={publicacion.id}
                                    nombrePublicacion={publicacion.nombre}
                                    recurso={recurso}
                                    client:load
                            />
                        </div>
                )}
            </div>

            <!-- Columna Derecha: Imagen 1 con iconos decorativos -->
            {publicacion.imagen1 && (
                    <div class="relative min-h-[320px] sm:min-h-[400px] md:min-h-[500px] flex items-start justify-center order-1 md:order-2">
                        <div class="relative w-[280px] h-[280px] sm:w-[320px] sm:h-[320px] md:w-[350px] md:h-[350px]">
                            <div class="absolute inset-0 rounded-[50%] bg-gradient-to-br from-blue-100 to-blue-200 overflow-hidden shadow-xl">
                                <img
                                        src={publicacion.imagen1}
                                        alt={publicacion.titulo1}
                                        class="h-full w-full object-cover object-center"
                                />
                            </div>

                            <div class="absolute -top-2 sm:-top-4 right-6 sm:right-8 w-10 h-10 sm:w-12 sm:h-12 bg-orange-600 rounded-lg flex items-center justify-center shadow-lg hover:scale-110 transition-transform cursor-pointer">
                                <Calculator className="w-5 h-5 sm:w-6 sm:h-6 text-white"/>
                            </div>

                            <div class="absolute top-1/3 -right-4 sm:-right-6 w-12 h-12 sm:w-14 sm:h-14 bg-gradient-to-br from-green-600 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg hover:scale-110 transition-transform cursor-pointer">
                                <HandCoins className="w-6 h-6 sm:w-7 sm:h-7 text-white"/>
                            </div>

                            <div class="hidden sm:block absolute -bottom-4 -right-6 md:-right-8 bg-white rounded-xl shadow-xl p-2.5 sm:p-3 w-28 sm:w-36 hover:scale-105 transition-transform">
                                <div class="flex items-center gap-1 mb-1.5 sm:mb-2">
                                    <TrendingUp className="w-3 h-3 sm:w-4 sm:h-4 text-blue-600"/>
                                    <span class="text-[10px] sm:text-xs font-semibold text-blue-600">Crecimiento</span>
                                </div>
                                <svg viewBox="0 0 120 60" class="w-full h-auto">
                                    <polyline points="10,50 40,45 70,35 100,20" fill="none" stroke="#3b82f6"
                                              stroke-width="2"/>
                                    <circle cx="10" cy="50" r="3" fill="#3b82f6"/>
                                    <circle cx="40" cy="45" r="3" fill="#3b82f6"/>
                                    <circle cx="70" cy="35" r="3" fill="#3b82f6"/>
                                    <circle cx="100" cy="20" r="3" fill="#3b82f6"/>
                                    <text x="5" y="58" font-size="8" fill="#666">2020</text>
                                    <text x="35" y="58" font-size="8" fill="#666">2021</text>
                                    <text x="65" y="58" font-size="8" fill="#666">2022</text>
                                    <text x="95" y="58" font-size="8" fill="#666">2023</text>
                                </svg>
                            </div>

                            <div class="absolute bottom-10 sm:bottom-12 -left-6 sm:-left-8 bg-orange-500 rounded-full w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center shadow-lg hover:scale-110 transition-transform">
                                <div class="text-center">
                                    <Users className="w-5 h-5 sm:w-6 sm:h-6 text-white mx-auto mb-0.5 sm:mb-1"/>
                                    <div class="text-white font-bold text-xs sm:text-sm leading-none">500+</div>
                                    <div class="text-white text-[7px] sm:text-[8px] leading-none mt-0.5">clientes</div>
                                </div>
                            </div>
                        </div>
                    </div>
            )}
        </div>
    </section>

    <section>
        <div class="bg-gray-100 p-6 sm:p-8 md:p-12">
            <div class="container mx-auto px-4">
                <h2 class="text-xl sm:text-2xl md:text-3xl font-bold mb-4 sm:mb-6 text-gray-800">
                    {publicacion.titulo2}
                </h2>
                <div class="text-sm sm:text-base text-gray-700 prose prose-sm sm:prose md:prose-lg max-w-none" set:html={publicacion.texto2}
                />
            </div>
        </div>
    </section>
    
    {publicacion && (
        <Footer
            showDownloadButton={!!recurso}
            idPublicacion={publicacion.id}
            nombrePublicacion={publicacion.nombre}
            recurso={recurso}
        />
    )}
    </>
    )}
</main>

</body>
</html>