---
import '../../styles/global.css';
import RegisterForm from '@/components/auth/RegisterForm';
import {Image} from 'astro:assets';
import logoAnfivius from '@/images/hero/LogoHorizontal.svg';
---

<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Registrarse - Anfibius</title>
</head>
<body class="bg-gray-50">
<div class="min-h-screen flex flex-col items-center justify-center p-4">
    <div class="w-full max-w-md">
        <!-- Logo -->
        <div class="flex justify-center mb-8">
            <Image
                    src={logoAnfivius}
                    alt="Logo Anfibius"
                    width={200}
                    height={400}
                    class="h-auto"
            />
        </div>

        <!-- Card de Registro -->
        <div class="bg-white rounded-lg shadow-lg p-8">
            <h1 class="text-2xl font-bold text-center mb-2">Crear Cuenta</h1>
            <p class="text-gray-600 text-center mb-6">Completa el formulario para registrarte</p>

            <RegisterForm client:load/>

            <div class="mt-6 text-center">
                <p class="text-sm text-gray-600">
                    ¿Ya tienes una cuenta?
                    <a href="/auth/login" class="text-[#005873] hover:text-[#7EB520] font-semibold">
                        Inicia sesión aquí
                    </a>
                </p>
            </div>
        </div>

        <div class="mt-4 text-center">
            <a href="/" class="text-sm text-gray-600 hover:text-gray-800">
                ← Volver al inicio
            </a>
        </div>
    </div>
</div>
</body>
</html>