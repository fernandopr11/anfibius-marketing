---
import '../styles/global.css';
import {Button} from "@/components/ui/button"
import {Star, UtensilsCrossed, HandCoins, Calculator, TrendingUp, Users} from "lucide-react"
import {Image} from 'astro:assets';
import empleado from '@/images/hero/empleado.jpg';
import Footer from "@/components/Footer.astro";
import logoAnfivius from '@/images/hero/LogoHorizontal.svg';
---

<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>Inicio</title>
</head>
<body>
<header class="w-full py-6">
    <div class="container mx-auto px-4 flex justify-center">
        <Image
                src={logoAnfivius}
                alt="Logo Anfibius"
                width={300}
                height={600}
                class="h-auto p-5"
        />
    </div>
</header>
<main class="min-h-screen bg-background">
    <section class="container mx-auto px-4 py-12 md:py-10">
        <div class="grid gap-12 md:grid-cols-2 items-start max-w-6xl mx-auto">
            <div class="space-y-6 text-center md:text-left order-2 md:order-1">
                <div class="space-y-4">
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight">
                        Guía rápida para contadores al momento de elegir un software contable
                    </h1>
                    <p class="text-base md:text-lg text-gray-600 leading-relaxed">
                        Aprende a elegir correctamente el software contable ideal para tu despacho o empresa.
                    </p>
                </div>

                <div class="flex justify-center md:justify-start">
                    <Button size="lg" className="text-base px-8 bg-[#7EB520] hover:bg-[#6DA018]" client:load>
                        Descargarla ahora
                    </Button>
                </div>
            </div>

            <div class="relative min-h-[400px] md:min-h-[500px] flex items-start justify-center order-1 md:order-2">
                <div class="relative w-[350px] h-[350px]">
                    <div class="absolute inset-0 rounded-[50%] bg-gradient-to-br from-blue-100 to-blue-200 overflow-hidden">
                        <Image
                                src={empleado}
                                alt="Chef profesional gestionando pedidos"
                                loading="eager"
                                width={800}
                                height={800}
                                class="h-full w-full object-cover object-center"
                        />
                    </div>

                    <div class="absolute -top-4 right-8 w-12 h-12 bg-orange-600 rounded-lg flex items-center justify-center shadow-lg hover:scale-110 transition-transform cursor-pointer">
                        <Calculator className="w-6 h-6 text-white"/>
                    </div>

                    <div class="absolute top-1/3 -right-6 w-14 h-14 bg-gradient-to-br from-green-600 to-emerald-600 rounded-xl flex items-center justify-center shadow-lg hover:scale-110 transition-transform cursor-pointer">
                        <HandCoins className="w-7 h-7 text-white"/>
                    </div>

                    <div class="absolute -bottom-4 -right-8 bg-white rounded-xl shadow-xl p-3 w-36 hover:scale-105 transition-transform">
                        <div class="flex items-center gap-1 mb-2">
                            <TrendingUp className="w-4 h-4 text-blue-600"/>
                            <span class="text-xs font-semibold text-blue-600">Crecimiento</span>
                        </div>
                        <svg viewBox="0 0 120 60" class="w-full h-auto">
                            <polyline points="10,50 40,45 70,35 100,20" fill="none" stroke="#3b82f6" stroke-width="2"/>
                            <circle cx="10" cy="50" r="3" fill="#3b82f6"/>
                            <circle cx="40" cy="45" r="3" fill="#3b82f6"/>
                            <circle cx="70" cy="35" r="3" fill="#3b82f6"/>
                            <circle cx="100" cy="20" r="3" fill="#3b82f6"/>
                            <text x="5" y="58" font-size="8" fill="#666">2020</text>
                            <text x="35" y="58" font-size="8" fill="#666">2021</text>
                            <text x="65" y="58" font-size="8" fill="#666">2022</text>
                            <text x="95" y="58" font-size="8" fill="#666">2023</text>
                        </svg>
                    </div>

                    <div class="absolute bottom-12 -left-8 bg-orange-500 rounded-full w-16 h-16 flex items-center justify-center shadow-lg hover:scale-110 transition-transform">
                        <div class="text-center">
                            <Users className="w-6 h-6 text-white mx-auto mb-1"/>
                            <div class="text-white font-bold text-sm leading-none">500+</div>
                            <div class="text-white text-[8px] leading-none mt-0.5">clientes</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section>
        <div class="bg-gray-100 p-8 md:p-12">
            <div class="container mx-auto px-4">
                <h2 class="text-2xl md:text-3xl font-bold mb-6 text-gray-800">Esta guía gratuita incluye:</h2>
                <ul class="space-y-4 text-gray-700">
                    <li class="flex items-start gap-3">
                        <span class="text-blue-600 mt-1">○</span>
                        <span>Criterios clave para comparar y elegir un software contable.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-blue-600 mt-1">○</span>
                        <span>Checklist práctico con los aspectos que no debes pasar por alto.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-blue-600 mt-1">○</span>
                        <span>Errores comunes al seleccionar un sistema y cómo evitarlos.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-blue-600 mt-1">○</span>
                        <span>Beneficios reales de un software contable bien implementado.</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <span class="text-blue-600 mt-1">○</span>
                        <span>Recomendaciones para estudios contables, pymes y empresas en crecimiento.</span>
                    </li>
                </ul>
            </div>
        </div>
    </section>


</main>
<Footer></Footer>
</body>
</html>